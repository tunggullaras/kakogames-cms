# Postgres / Supabase connection string
DATABASE_URL=postgresql://postgres:yourpassword@db.yourproject.supabase.co:5432/postgres

# Secret used to sign admin login sessions (use a long random string in production)
JWT_SECRET=replace-with-a-long-random-string

PORT=3000

# Comma-separated list of frontend origins allowed to call this API.
# Needed if you host the homepage separately (e.g. on Netlify) from this backend.
# Leave blank to allow same-origin only (backend also serves the homepage itself).
ALLOWED_ORIGINS=https://your-site.netlify.app
